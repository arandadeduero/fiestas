{% extends "layout.njk" %}

{% block bodyClass %}fiestas-page fiestas-collaborators-page{% endblock %}
{% block footerClass %} site-footer--fiestas{% endblock %}

{% block body %}
<main class="fiestas-app fiestas-plan-app fiestas-collaborators-app" data-fiesta-collaborators-page>
  <section class="fiestas-plan-screen fiestas-collaborators-screen">
    <header class="fiestas-plan-page-head fiestas-collaborators-page-head">
      <div class="fiestas-plan-topbar">
        <a class="fiestas-plan-logo" href="/" aria-label="Volver a la agenda">
          <img src="/assets/favicon.png" alt="" />
        </a>
        <h1>Colaboradores</h1>
        <span class="fiestas-plan-header-share" aria-hidden="true"></span>
      </div>
      <a class="fiestas-plan-import-back" href="/">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        <span>Volver a la agenda</span>
      </a>
    </header>

    <section class="fiestas-collaborators-intro" aria-labelledby="fiestas-collaborators-title">
      <h2 id="fiestas-collaborators-title">Entidades y proyectos que nos apoyan</h2>
      <p>
        Ayuntamiento de Aranda de Duero. Concejalía de Innovación no recibe ninguna contraprestación económica ni de ningún tipo de las personas o entidades que aparecen aquí.
        Esta página existe para agradecer la promoción del proyecto en sus redes.
      </p>
      <p>
        Si tú también has hablado de nosotros o de nuestra web y nos hemos olvidado de ti, perdónanos y envíanos una captura para incluirte.
      </p>
    </section>

    <section class="fiestas-collaborators-directory">
      <div class="fiestas-collaborators-empty">
        <i class="fa-solid fa-people-group" aria-hidden="true"></i>
        <p>Todavía no hay entidades ni proyectos que reseñar. Si difundes las fiestas o esta web, escríbenos y te incluimos aquí.</p>
      </div>
    </section>
  </section>
</main>

<nav class="fiestas-bottom-nav" aria-label="Navegación de fiestas">
  <a class="fiestas-bottom-link" href="/">
    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
    <span>Agenda</span>
  </a>
  <a class="fiestas-bottom-link" href="/mapa/">
    <svg class="fiestas-bottom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.35" />
    </svg>
    <span>Mapa</span>
  </a>
  <a class="fiestas-bottom-link" href="/plan/">
    <i class="fa-regular fa-heart" aria-hidden="true"></i>
    <span>Mi plan</span>
  </a>
  {% if casetasEnabled %}
  <a class="fiestas-bottom-link" href="/casetas/">
    <i class="fa-solid fa-store" aria-hidden="true"></i>
    <span>Casetas</span>
  </a>
  {% endif %}
  <button class="fiestas-bottom-link" type="button" data-menu-open aria-label="Abrir más opciones">
    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
    <span>Más</span>
    <span class="fiestas-hint-dot" data-menu-hint-dot hidden aria-hidden="true"></span>
  </button>
</nav>

{% include "partials/menu-drawer.njk" %}
{% include "partials/subscribe-modal.njk" %}
{% endblock %}
