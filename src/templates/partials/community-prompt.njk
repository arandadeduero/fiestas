<div
  class="community-prompt"
  data-community-prompt
  data-community-prompt-campaign-id="{{ communityPromptCampaign.id }}"
  data-community-prompt-start="{{ communityPromptCampaign.startDate }}"
  data-community-prompt-end="{{ communityPromptCampaign.endDate }}"
  hidden
>
  <aside
    class="community-prompt-panel"
    role="region"
    aria-live="polite"
    aria-labelledby="community-prompt-title"
    aria-describedby="community-prompt-description"
  >
    <div class="community-prompt-handle" aria-hidden="true"></div>
    <button class="community-prompt-close" type="button" data-community-prompt-dismiss aria-label="Cerrar">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <div class="community-prompt-heading">
      <img class="community-prompt-logo" src="/assets/favicon-128.png" alt="" />
      <div>
        <p class="community-prompt-kicker">AYUNTAMIENTO DE ARANDA DE DUERO</p>
        <h2 class="community-prompt-title" id="community-prompt-title">¿Te está sirviendo la agenda?</h2>
      </div>
    </div>

    <p class="community-prompt-copy" id="community-prompt-description">
      Si quieres seguir al día con lo que pasa en Aranda de Duero, puedes unirte a la comunidad.
    </p>

    {# Canal de WhatsApp desactivado hasta que exista. #}

    <div class="community-prompt-alternatives" aria-label="Otras formas de seguir al Ayuntamiento de Aranda de Duero">
      <a href="https://www.instagram.com/ayuntamientoarandadeduero" target="_blank" rel="noopener noreferrer" data-community-prompt-channel="instagram">
        <i class="fa-brands fa-instagram" aria-hidden="true"></i>
        <span>Instagram</span>
      </a>
      <a href="https://www.facebook.com/aytoarandadeduero" target="_blank" rel="noopener noreferrer" data-community-prompt-channel="facebook">
        <i class="fa-brands fa-facebook" aria-hidden="true"></i>
        <span>Facebook</span>
      </a>
    </div>

    <button class="community-prompt-never" type="button" data-community-prompt-never>
      No volver a recordármelo
    </button>
  </aside>
</div>
