  <aside class="calendar-modal-panel fiestas-ended-panel" role="dialog" aria-modal="true" aria-labelledby="fiestas-ended-title">
    <button class="calendar-modal-close fiestas-ended-panel-close" type="button" data-fiestas-ended-close aria-label="Cerrar">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <img class="fiestas-ended-logo" src="/assets/icons/fiestas-192.png" alt="Escudo del Ayuntamiento de Aranda de Duero" width="120" height="120" />
